# ============================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ============================================
APP_NAME=URA-Dvelopers
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo

# URL base para links de pagamento
# Esta URL será usada para gerar os links enviados via SMS
PAYMENT_BASE_URL=https://seu-dominio.com/pagamento

# ============================================
# BANCO DE DADOS
# ============================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ura_database
DB_USERNAME=postgres
DB_PASSWORD=postgres

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ura_database
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# RETELL AI - COBRANÇA
# ============================================

# API Key do Retell AI
RETELL_API_KEY=your_retell_api_key_here

# Agent ID para cobrança
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxx

# Nome do atendente de cobrança
AGENT_NAME=Marcos

# ============================================
# RETELL AI - VENDAS
# ============================================

# API Key do Retell AI para vendas (pode ser a mesma)
RETELL_API_KEY_SALES=your_retell_api_key_here

# Agent ID para vendas (OBRIGATÓRIO - diferente do de cobrança)
RETELL_AGENT_ID_SALES=agent_vendas_xxxxxxxxxxxxxx

# Nome do vendedor
SALES_AGENT_NAME=Carlos

# ============================================
# TWILIO - SMS E VOZ
# ============================================
# Obtenha suas credenciais em: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+5511999999999

# Webhook para status de SMS (callback do Twilio)
# Configure em: https://console.twilio.com/us1/develop/sms/settings/general
TWILIO_SMS_STATUS_WEBHOOK=${APP_URL}/api/webhooks/twilio/sms-status

# ============================================
# RETELL AI
# ============================================
# Obtenha suas credenciais em: https://retellai.com/
# RETELL_API_KEY=your_retell_api_key_here

# ============================================
# GATEWAY DE PAGAMENTO
# ============================================
# Descomente e configure o gateway que você for usar

# Mercado Pago
# MERCADOPAGO_ACCESS_TOKEN=your_access_token
# MERCADOPAGO_PUBLIC_KEY=your_public_key

# Gerencianet (Efí Pay)
# GERENCIANET_CLIENT_ID=your_client_id
# GERENCIANET_CLIENT_SECRET=your_client_secret
# GERENCIANET_SANDBOX=true
# GERENCIANET_CERTIFICATE_PATH=/path/to/certificate.pem

# Stripe
# STRIPE_KEY=pk_test_xxxxxxxxxxxxx
# STRIPE_SECRET=sk_test_xxxxxxxxxxxxx

# ============================================
# FILAS E WORKERS
# ============================================
QUEUE_CONNECTION=redis

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# N8N WEBHOOK (INTEGRAÇÃO)
# ============================================
N8N_WEBHOOK_URL=http://n8n:5678/webhook/ligacao

# ============================================
# LOGS
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================
# SESSÕES
# ============================================
SESSION_DRIVER=file

# ============================================
# EMPRESA
# ============================================

# Nome da empresa
COMPANY_NAME=Dvelopers Soluções

# Telefone da empresa (para contato)
COMPANY_PHONE=(11) 3333-4444

# Email da empresa
COMPANY_EMAIL=contato@dvelopers.com.br

# ============================================
# CORS
# ============================================

# Origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=*

# ============================================
# LOGGING
# ============================================

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=
LOG_LEVEL=debug

# ============================================
# CACHE
# ============================================

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
